{
  "name": "educenter-cloud",
  "private": true,
  "version": "0.0.0",
  "description": "EduCenter Cloud — multi-tenant education center management (modular monolith)",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter api test:integration",
    "contract:lint": "pnpm --filter @educenter/api-contract lint",
    "contract:generate": "pnpm --filter @educenter/api-contract generate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:generate": "pnpm --filter api prisma:generate"
  }
}
