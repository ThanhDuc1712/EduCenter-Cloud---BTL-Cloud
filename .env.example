# EduCenter Cloud — LOCAL DEVELOPMENT environment template.
# Copy to `.env` (git-ignored) and replace every `change-me-*` value
# (scripts/windows/setup-local.ps1 does this for you with random values).
# Never put real cloud credentials or real personal data in this file.

# ---------- PostgreSQL (docker compose) ----------
POSTGRES_HOST_PORT=5433
# Bootstrap superuser — used ONLY by the container init scripts, never by the app.
POSTGRES_PASSWORD=change-me-superuser
# Schema owner, used only for migrations (D-25).
EDU_MIGRATOR_PASSWORD=change-me-migrator
# Runtime role: DML only, not owner, not superuser, no BYPASSRLS (D-25).
EDU_RUNTIME_PASSWORD=change-me-runtime

# ---------- API (apps/api) ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=log
# Browser origin of the SPA (same-origin in cloud per D-03; Vite dev server locally).
APP_ORIGIN=http://localhost:5173
# The app connects as edu_runtime. Keep passwords in sync with the values above.
DATABASE_URL=postgresql://edu_runtime:change-me-runtime@localhost:5433/educenter
# Prisma migrate uses the migrator (owner) role.
MIGRATION_DATABASE_URL=postgresql://edu_migrator:change-me-migrator@localhost:5433/educenter
DB_CONNECTION_LIMIT=10
DB_HEALTH_TIMEOUT_MS=2000
JSON_BODY_LIMIT=1mb
INTERNAL_BODY_LIMIT=256kb
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=20000

# ---------- Authentication (login / registration) ----------
# session: every page/API needs a login (default, use this for anything shared).
# demo:    requests without a login session fall back to the demo context below (local demos,
#          integration / e2e scripts). A real login session always takes precedence.
AUTH_MODE=session
# Public self-registration creates a STUDENT account with a new student profile.
REGISTRATION_ENABLED=true
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=24
# Password of the accounts created by `pnpm --filter api db:seed` (default Demo@12345).
# SEED_DEMO_PASSWORD=

# ---------- Demo context (used only when AUTH_MODE=demo) ----------
# DEMO_MODE=true lets the UI switch between the seeded Admin / Teacher / Student personas.
# DEMO_TENANT_SLUG is also the center pre-filled on the login / registration form.
DEMO_MODE=true
DEMO_TENANT_SLUG=hanoi-center
DEMO_DEFAULT_PERSONA=admin
# >= 32 random characters. Signs the persona cookie.
DEMO_CONTEXT_SECRET=change-me-demo-context-secret-at-least-32-chars

# ---------- Materials pipeline ----------
# LOCAL mode: local filesystem + in-process worker (shown as MOCK in the UI).
# CLOUD mode: STORAGE_PROVIDER=oss and PROCESSING_PROVIDER=aliyun-fc.
STORAGE_PROVIDER=local
PROCESSING_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
INTERNAL_BASE_URL=http://127.0.0.1:3000
# keyId:secret[,keyId:secret] — secrets >= 32 chars. Two keys may be valid during rotation.
CALLBACK_HMAC_KEYS=k1:change-me-callback-hmac-secret-at-least-32-chars
CALLBACK_HMAC_ACTIVE_KEY_ID=k1
UPLOAD_MAX_BYTES=10485760
SIGNED_URL_TTL_SECONDS=120
RECONCILE_INTERVAL_SECONDS=60
PROCESSING_TIMEOUT_SECONDS=300
PROCESSING_MAX_ATTEMPTS=3

# ---------- Alibaba Cloud (CLOUD mode only — leave empty locally) ----------
ALIYUN_REGION=
ALIYUN_ACCOUNT_ID=
OSS_QUARANTINE_BUCKET=
OSS_PUBLISHED_BUCKET=
# RAM user "educenter-api" (never the root account). In Azure these come from Key Vault references.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
ALIYUN_FC_FUNCTION_NAME=
ALIYUN_SLS_PROJECT=
ALIYUN_SLS_LOGSTORE=
# Read-only RAM user for SLS / CloudMonitor dashboards.
ALIYUN_READONLY_ACCESS_KEY_ID=
ALIYUN_READONLY_ACCESS_KEY_SECRET=

# ---------- Azure (CLOUD mode only — leave empty locally) ----------
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_KEY_VAULT_URL=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_APP_SERVICE_NAME=
AZURE_POSTGRES_SERVER_NAME=
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
# Comma-separated CIDRs allowed to call /api/v1/cloud/* in production.
OPS_ALLOWED_CIDRS=
