# EduCenter Cloud — LOCAL DEVELOPMENT environment template.
# Copy to `.env` (git-ignored) and replace every `change-me-*` value.
# Never put real cloud credentials or real personal data in this file.

# ---------- PostgreSQL (docker compose) ----------
POSTGRES_HOST_PORT=5433
# Bootstrap superuser — used ONLY by the container init scripts, never by the app.
POSTGRES_PASSWORD=change-me-superuser
# Schema owner, used only for migrations (D-25).
EDU_MIGRATOR_PASSWORD=change-me-migrator
# Runtime role: DML only, not owner, not superuser, no BYPASSRLS (D-25).
EDU_RUNTIME_PASSWORD=change-me-runtime

# ---------- API (apps/api) ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=log
# Browser origin of the SPA (same-origin in cloud per D-03; Vite dev server locally).
APP_ORIGIN=http://localhost:5173
# The app connects as edu_runtime. Keep passwords in sync with the values above.
DATABASE_URL=postgresql://edu_runtime:change-me-runtime@localhost:5433/educenter
# Prisma migrate uses the migrator (owner) role.
MIGRATION_DATABASE_URL=postgresql://edu_migrator:change-me-migrator@localhost:5433/educenter
DB_CONNECTION_LIMIT=10
DB_HEALTH_TIMEOUT_MS=2000
JSON_BODY_LIMIT=1mb
INTERNAL_BODY_LIMIT=256kb
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=20000
