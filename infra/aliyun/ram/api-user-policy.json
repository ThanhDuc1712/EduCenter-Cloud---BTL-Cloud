{
  "Version": "1",
  "Statement": [
    {
      "Sid": "SignUploadPolicyAndManageQuarantine",
      "Effect": "Allow",
      "Action": ["oss:PutObject", "oss:GetObject", "oss:GetObjectMeta", "oss:DeleteObject", "oss:ListObjects"],
      "Resource": ["acs:oss:*:*:${OSS_QUARANTINE_BUCKET}", "acs:oss:*:*:${OSS_QUARANTINE_BUCKET}/tenants/*"]
    },
    {
      "Sid": "SignedDownloadsResultsAndCleanup",
      "Effect": "Allow",
      "Action": ["oss:GetObject", "oss:GetObjectMeta", "oss:DeleteObject", "oss:ListObjects"],
      "Resource": ["acs:oss:*:*:${OSS_PUBLISHED_BUCKET}", "acs:oss:*:*:${OSS_PUBLISHED_BUCKET}/*"]
    },
    {
      "Sid": "BucketHealthForDashboard",
      "Effect": "Allow",
      "Action": ["oss:GetBucketInfo", "oss:GetBucketVersioning", "oss:GetBucketLifecycle"],
      "Resource": ["acs:oss:*:*:${OSS_QUARANTINE_BUCKET}", "acs:oss:*:*:${OSS_PUBLISHED_BUCKET}"]
    }
  ]
}
