{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetObject",
        "oss:GetObjectVersion"
      ],
      "Resource": [
        "acs:oss:*:*:<QUARANTINE_BUCKET>/quarantine/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:PutObject"
      ],
      "Resource": [
        "acs:oss:*:*:<PUBLISHED_BUCKET>/published/*",
        "acs:oss:*:*:<PUBLISHED_BUCKET>/previews/*",
        "acs:oss:*:*:<PUBLISHED_BUCKET>/results/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetObject"
      ],
      "Resource": [
        "acs:oss:*:*:<PUBLISHED_BUCKET>/results/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "log:PostLogStoreLogs"
      ],
      "Resource": [
        "acs:log:*:*:project/<SLS_PROJECT>/logstore/<SLS_LOGSTORE>"
      ]
    }
  ]
}
