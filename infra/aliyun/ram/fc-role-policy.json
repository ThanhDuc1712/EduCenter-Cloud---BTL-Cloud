{
  "Version": "1",
  "Statement": [
    {
      "Sid": "ReadQuarantineSourcesOnly",
      "Effect": "Allow",
      "Action": ["oss:GetObject", "oss:GetObjectVersion", "oss:GetObjectMeta"],
      "Resource": ["acs:oss:*:*:${OSS_QUARANTINE_BUCKET}/tenants/*"]
    },
    {
      "Sid": "WritePublishedOutputs",
      "Effect": "Allow",
      "Action": ["oss:PutObject", "oss:GetObject"],
      "Resource": ["acs:oss:*:*:${OSS_PUBLISHED_BUCKET}/tenants/*", "acs:oss:*:*:${OSS_PUBLISHED_BUCKET}/results/*"]
    },
    {
      "Sid": "WriteFunctionLogs",
      "Effect": "Allow",
      "Action": ["log:PostLogStoreLogs"],
      "Resource": ["acs:log:*:*:project/${ALIYUN_SLS_PROJECT}/logstore/${ALIYUN_SLS_LOGSTORE}"]
    }
  ]
}
