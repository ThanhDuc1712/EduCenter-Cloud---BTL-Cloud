{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "oss:PutObject",
        "oss:GetObject"
      ],
      "Resource": [
        "acs:oss:*:*:<QUARANTINE_BUCKET>/quarantine/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetObject",
        "oss:GetObjectVersion",
        "oss:DeleteObject"
      ],
      "Resource": [
        "acs:oss:*:*:<PUBLISHED_BUCKET>/published/*",
        "acs:oss:*:*:<PUBLISHED_BUCKET>/previews/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetObject",
        "oss:GetObjectVersion"
      ],
      "Resource": [
        "acs:oss:*:*:<PUBLISHED_BUCKET>/results/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:ListObjects",
        "oss:GetBucketInfo",
        "oss:GetBucketVersioning",
        "oss:GetBucketLifecycle"
      ],
      "Resource": [
        "acs:oss:*:*:<QUARANTINE_BUCKET>",
        "acs:oss:*:*:<PUBLISHED_BUCKET>"
      ]
    }
  ]
}
