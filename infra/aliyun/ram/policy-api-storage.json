{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["oss:PutObject"],
      "Resource": ["acs:oss:*:*:<QUARANTINE_BUCKET>/quarantine/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["oss:GetObject", "oss:GetObjectVersion", "oss:DeleteObject"],
      "Resource": [
        "acs:oss:*:*:<PUBLISHED_BUCKET>/published/*",
        "acs:oss:*:*:<PUBLISHED_BUCKET>/previews/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["oss:GetObject", "oss:GetObjectVersion"],
      "Resource": ["acs:oss:*:*:<PUBLISHED_BUCKET>/results/*"]
    }
  ]
}
