{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "EduCenter Cloud API — NestJS modular monolith",
  "scripts": {
    "prebuild": "pnpm run prisma:generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "pnpm run prisma:generate && tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm run prisma:generate",
    "test": "jest",
    "test:integration": "pnpm run prisma:generate && jest --config jest.integration.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@azure/identity": "4.14.1",
    "@azure/keyvault-secrets": "4.12.0",
    "@educenter/shared": "workspace:*",
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ali-oss": "6.23.0",
    "applicationinsights": "3.17.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.11",
    "@types/ali-oss": "6.23.4",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
